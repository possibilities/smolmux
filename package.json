{
  "name": "smolmux",
  "version": "0.9.2",
  "packageManager": "bun@1.4.0",
  "description": "A terminal multiplexer driven over a socket",
  "type": "module",
  "bin": {
    "smolmux": "./src/index.ts"
  },
  "scripts": {
    "explorer": "bun examples/explorer/serve.ts",
    "explorer:build": "bun examples/explorer/build.ts",
    "explorer:check": "bun examples/explorer/check-browser.ts",
    "generate:events-schema": "bun src/event-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:pty": "SMOLMUX_RUN_PTY_TESTS=1 bun test tests/instance.e2e.test.ts",
    "install:source": "scripts/install.sh --install",
    "gate:local": "scripts/local-gate.sh"
  },
  "dependencies": {
    "@opentui/core": "0.5.10",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.0",
    "@types/three": "^0.185.4",
    "ghostty-web": "0.4.0",
    "three": "^0.185.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@opentui/core": "https://github.com/possibilities/opentui/releases/download/agentbrowse-v0.5.10.1/opentui-core-0.5.10-agentbrowse.1.tgz",
    "@opentui/core-darwin-arm64": "https://github.com/possibilities/opentui/releases/download/agentbrowse-v0.5.10.1/opentui-core-darwin-arm64-0.5.10-agentbrowse.1.tgz"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT",
  "exports": {
    "./client": "./src/api-client.ts",
    "./protocol": "./src/protocol.ts",
    "./foreground": "./src/host.ts"
  }
}
