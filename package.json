{
  "name": "smolmux",
  "version": "0.8.0",
  "packageManager": "bun@1.4.0",
  "description": "A terminal multiplexer driven over a socket",
  "type": "module",
  "bin": {
    "smolmux": "./src/index.ts"
  },
  "scripts": {
    "generate:events-schema": "bun src/event-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:pty": "SMOLMUX_RUN_PTY_TESTS=1 bun test tests/instance.e2e.test.ts",
    "install:source": "scripts/install.sh --install",
    "gate:local": "scripts/local-gate.sh"
  },
  "dependencies": {
    "@opentui/core": "0.5.10",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@opentui/core": "https://github.com/possibilities/opentui/releases/download/agentbrowse-v0.5.10.1/opentui-core-0.5.10-agentbrowse.1.tgz",
    "@opentui/core-darwin-arm64": "https://github.com/possibilities/opentui/releases/download/agentbrowse-v0.5.10.1/opentui-core-darwin-arm64-0.5.10-agentbrowse.1.tgz"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT"
}
